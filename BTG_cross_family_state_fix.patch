 /// Per-state nested cross-family depth. Lifetime sync owns 0x50A0/0x50A8.
 pub const STATE_CROSS_FAMILY_DEPTH: i64 = 0x50B0;
+/// Child-state pointers for guest registers that are nonvolatile in the native
+/// Win64 ABI but are still architectural VM state across family transitions.
+///
+/// A generated child can be reached through a tail-jump or through nested
+/// family transitions, so the native ABI's "callee preserves RBX/RBP/..." rule
+/// is not sufficient to reconstruct the parent VM state.  These slots let the
+/// shared return bridge pull the authoritative values directly from the child
+/// family state, exactly like the existing RAX/volatile pointer plumbing.
+///
+/// 0x50A0/0x50A8 are lifetime-sync, 0x50B0 is depth; keep this table above
+/// those fixed control slots and below the 0x8000 family-state stride.
+pub const STATE_CROSS_FAMILY_NONVOLATILE_PTRS: [(usize, i64); 9] = [
+    (3, 0x50C0),  // RBX
+    (4, 0x50C8),  // RSP
+    (5, 0x50D0),  // RBP
+    (6, 0x50D8),  // RSI
+    (7, 0x50E0),  // RDI
+    (12, 0x50E8), // R12
+    (13, 0x50F0), // R13
+    (14, 0x50F8), // R14
+    (15, 0x5100), // R15
+];
 /// Eight re-entry depths are reserved per thread bucket; depth 7 cannot spawn another child.
 pub const MAX_CROSS_FAMILY_DEPTH: u64 = 7;
